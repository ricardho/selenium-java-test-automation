# Template for the local .env file (git-ignored). Copy it and fill in the values:
#   Windows:     copy .env.example .env
#   Linux/macOS: cp .env.example .env
#
# TestConfig resolution order: -Dkey > environment variable > .env > config.properties > default.
# In CI these values come from GitHub Actions repository secrets, not from this file.

# ----- Secrets (required) -----
# Swag Labs password: shown on the login page of https://www.saucedemo.com
SAUCE_PASSWORD=
# Restful Booker admin credentials: see "Auth - CreateToken" in https://restful-booker.herokuapp.com/apidoc
API_USERNAME=
API_PASSWORD=

# ----- Optional overrides (defaults live in src/test/resources/config.properties) -----
# BASE_URL=https://www.saucedemo.com
# API_BASE_URL=https://restful-booker.herokuapp.com
# BROWSER=chrome
# HEADLESS=false
# TIMEOUT_SECONDS=10
# GRID_URL=http://localhost:4444
